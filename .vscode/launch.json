{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Mod3ProfilingPerformance", // Cambia esto al binario compilado, debe ser el de debug
            "args": [
                "uno_arg1",
                "dos_arg2",
                "tres_arg3"
            ], // Sustituye por tus argumentos
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Habilitar impresión de formato GDB para valores",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "my_make_debug", // Es el label de la task.json
            //"miDebuggerPath": "/usr/bin/gdb"  // No hace falta, encuentra al gdb en el PATH
        }
    ]
}